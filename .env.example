# Copy this file to .env and fill values locally. Never commit .env.
# Optional: without a key the legacy parser falls back to rules; the Live Agent
# is deterministic and does not require an LLM key.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Optional explicit paths. Leave blank to auto-detect.
# FREECAD_BIN=C:\Program Files\FreeCAD 1.1\bin\FreeCADCmd.exe
# FREECAD_GUI=C:\Program Files\FreeCAD 1.1\bin\FreeCAD.exe
FREECAD_BIN=
FREECAD_GUI=
